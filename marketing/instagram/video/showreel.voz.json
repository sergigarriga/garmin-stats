  "lines": [
    {
      "scene": 0.3,
      "text": "¿Te pasa que miras el reloj después de correr y no entiendes ni la mitad de los datos?"
    },
    {
      "scene": 2.0,
      "text": "Pues para eso hemos hecho Runch: tus datos, por fin explicados en cristiano.",
      "say": "Pues para eso hemos hecho Ranch: tus datos, por fin explicados en cristiano."
    },
    {
      "scene": 4.0,
      "text": "Abres la app y ves de un vistazo cómo has dormido, cómo llegas hoy y cuánta energía te queda."
    },
    {
      "scene": 8.1,
      "text": "Te dice a qué ritmo entrenar, para que dejes de correrlo todo en modo ego."
    },
    {
      "scene": 10.1,
      "text": "Y tienes un entrenador con IA que te escucha y te ajusta el plan cada semana."
    },
    {
      "scene": 12.1,
      "text": "Porque correr mola… pero en compañía, mola mucho más."
    },
    {
      "scene": 13.7,
      "text": "Esto es Runch. Síguenos y nos vemos en la próxima.",
